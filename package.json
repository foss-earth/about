{
  "name": "@foss-earth/about",
  "version": "0.1.0",
  "private": true,
  "description": "Host-supplied build provenance and repository graph presentation",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "./styles/panel.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panel": {
      "source": "./src/panel.ts",
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./panel.css": "./styles/panel.css",
    "./graph-template.html": "./templates/repository-graph.html",
    "./vite": {
      "source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "bin": {
    "foss-earth-repository-graph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "styles",
    "templates",
    "scripts",
    "LICENSE",
    "README.md",
    "AGENTS.md",
    "docs",
    "src",
    "tsconfig.json",
    "NOTICE",
    "fixtures/vite",
    "tests/vite"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "test": "vitest run --maxWorkers=50%",
    "ci": "npm run check:implementation",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "check:implementation": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-public-consumer.mjs && npm run check:vite-consumer",
    "check:vite-consumer": "node fixtures/vite/public-consumer.mjs && tsc -p fixtures/vite/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "globals": "17.6.0",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "vite": "8.3.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
